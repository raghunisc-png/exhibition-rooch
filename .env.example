# Used by docker-compose.yml: both for its own ${VAR} substitution (db
# credentials, frontend build arg) and as the backend container's env_file
# (i.e. everything app/config.py reads — see backend/.env.example for the
# full list of backend-only settings, e.g. JWT_SECRET_KEY, Twilio, S3).

POSTGRES_USER=expo_user
POSTGRES_PASSWORD=expo_pass
POSTGRES_DB=expo_invoices

# Base URL the frontend container is built to call. Since the frontend is
# served as static files (baked in at build time), this must be an address
# reachable from the *browser*, not from inside the Docker network — e.g.
# your machine's LAN IP if testing from a phone, not "backend" or "db".
VITE_API_BASE_URL=http://localhost:8000

# --- Backend settings (passed through via env_file) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
COMPANY_NAME=Rooch Fashions
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
